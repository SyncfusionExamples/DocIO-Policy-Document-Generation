@{
    ViewData["Title"] = "Policy Document Generation";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        background: #f0f4f8;
        min-height: 100vh;
        padding: 20px;
    }

    .page-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 40px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        color: white;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
    }

        .page-header h1 {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .page-header p {
            font-size: 18px;
            opacity: 0.95;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .page-header .badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.25);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 15px;
            backdrop-filter: blur(10px);
        }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }

    .card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            transform: translateY(-2px);
        }

    .card-title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .card-title .icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

    .upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .upload-zone:hover {
            border-color: #667eea;
            background: #f0f4ff;
        }

        .upload-zone.has-file {
            border-color: #10b981;
            border-style: solid;
            background: #ecfdf5;
        }

        .upload-zone input[type="file"] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .upload-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .upload-text {
        font-size: 15px;
        color: #475569;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .upload-hint {
        font-size: 13px;
        color: #94a3b8;
    }

    .file-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #10b981;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin-top: 15px;
    }

        .file-badge button {
            background: rgba(255, 255, 255, 0.3);
            border: none;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            transition: all 0.2s;
        }

            .file-badge button:hover {
                background: rgba(255, 255, 255, 0.5);
            }

    .default-badge {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 10px;
    }

    .info-badge {
        display: inline-block;
        background: #dbeafe;
        color: #1e40af;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 12px;
        border-left: 4px solid #1e40af;
        line-height: 1.5;
    }

    .options-card {
        grid-column: 1 / -1;
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .option-box {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        transition: all 0.3s ease;
    }

        .option-box:hover {
            border-color: #cbd5e1;
        }

    .option-label {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 12px;
        display: block;
    }

    .radio-group, .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .radio-item, .checkbox-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .radio-item:hover, .checkbox-item:hover {
            border-color: #667eea;
            background: #f0f4ff;
        }

        .radio-item input, .checkbox-item input {
            width: 18px;
            height: 18px;
            accent-color: #667eea;
            cursor: pointer;
        }

        .radio-item:has(input:checked), .checkbox-item:has(input:checked) {
            border-color: #667eea;
            background: #f0f4ff;
        }

    .item-content {
        flex: 1;
    }

    .item-title {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .item-desc {
        font-size: 12px;
        color: #64748b;
    }

    .select-box {
        width: 100%;
        padding: 12px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
        background: white;
        cursor: pointer;
        transition: all 0.3s;
    }

        .select-box:hover, .select-box:focus {
            border-color: #667eea;
            outline: none;
        }

    .checkbox-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .checkbox-item.full-width {
        grid-column: 1 / -1;
    }

    .action-section {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        text-align: center;
    }

    .generate-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 18px 50px;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

        .generate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
        }

        .generate-btn:active {
            transform: translateY(0);
        }

    .info-section {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        margin-top: 30px;
    }

    .info-title {
        font-size: 22px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
        text-align: center;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .feature {
        text-align: center;
        padding: 20px;
    }

    .feature-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #f0f4ff 0%, #e9d5ff 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 12px;
    }

    .feature h4 {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .feature p {
        font-size: 13px;
        color: #64748b;
        line-height: 1.5;
    }

    .error-message {
        background: #fee2e2;
        border: 2px solid #fecaca;
        color: #dc2626;
        padding: 15px 20px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        margin-top: 20px;
        display: none;
    }

        .error-message:not(:empty) {
            display: block;
        }

    /* Bookmark Documents Section Styles */
    .bookmark-docs-section {
        display: none;
        margin-top: 20px;
        padding: 20px;
        background: #f8fafc;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
    }

        .bookmark-docs-section.visible {
            display: block;
        }

    .bookmark-docs-title {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .bookmark-upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 30px 20px;
        text-align: center;
        background: white;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 15px;
    }

        .bookmark-upload-zone:hover {
            border-color: #667eea;
            background: #f0f4ff;
        }

    .bookmark-upload-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .bookmark-upload-text {
        font-size: 14px;
        color: #475569;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .bookmark-upload-hint {
        font-size: 12px;
        color: #94a3b8;
    }

    .bookmark-file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .bookmark-info-note {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 12px;
        color: #92400e;
        margin-bottom: 15px;
        font-weight: 600;
        line-height: 1.5;
    }

    .uploaded-files-list {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid #e2e8f0;
        margin-top: 15px;
        max-height: 300px;
        overflow-y: auto;
    }

    .uploaded-file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border-bottom: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

        .uploaded-file-item:last-child {
            border-bottom: none;
        }

        .uploaded-file-item:hover {
            background: #f8fafc;
        }

    .file-item-info {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }

    .file-item-icon {
        width: 32px;
        height: 32px;
        background: #dbeafe;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .file-item-details {
        flex: 1;
    }

    .file-item-name {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        word-break: break-word;
    }

    .file-item-size {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .file-item-remove {
        background: #fee2e2;
        border: none;
        color: #dc2626;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        line-height: 1;
        transition: all 0.2s;
        flex-shrink: 0;
    }

        .file-item-remove:hover {
            background: #fecaca;
        }

    .file-count-badge {
        display: inline-block;
        background: #dbeafe;
        color: #1e40af;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 12px;
    }
    /* Digital Signature Styles */
    .signature-section {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
        display: none;
    }

        .signature-section.visible {
            display: block;
        }

    .signature-title {
        font-weight: 600;
        color: #856404;
        margin-bottom: 15px;
        font-size: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .text-input {
        width: 100%;
        padding: 10px 12px;
        font-size: 14px;
        border: 2px solid #ddd;
        border-radius: 6px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        box-sizing: border-box;
        transition: border-color 0.3s ease;
    }

        .text-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
        }

    .helper-text {
        color: #666;
        font-size: 12px;
        margin-top: 5px;
        line-height: 1.5;
    }

    @@media (max-width: 1024px) {
        .content-grid {
            grid-template-columns: 1fr;
        }

        .options-grid {
            grid-template-columns: 1fr;
        }

        .features {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 32px;
        }

        .checkbox-list {
            grid-template-columns: 1fr;
        }

        .features {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-wrapper">
    <!-- Header -->
    <div class="page-header">
        <div class="badge">🛡️ InsureDoc Platform</div>
        <h1>Policy Document Generator</h1>
        <p>Automate policy schedules, endorsements, certificates, and claims documentation with intelligent mail merge</p>
    </div>

    @using (Html.BeginForm("GenerateDocument", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <!-- File Upload Section -->
        <div class="content-grid">
            <!-- Template Upload -->
            <div class="card">
                <div class="card-title">
                    <div class="icon">📄</div>
                    Policy Template
                </div>
                <div class="upload-zone" id="template-zone">
                    <div class="upload-icon">📋</div>
                    <div class="upload-text">Click to upload template</div>
                    <div class="upload-hint">Word document (.docx, .doc, .rtf, .md, .html,.txt) with merge fields</div>
                    @Html.TextBox("templateFile", null, new { type = "file", accept = ".docx,.rtf,.doc,.md,.html,.txt", onchange = "handleUpload(this, 'template')" })
                    <div class="file-badge" id="template-badge" style="display: none;">
                        ✓ <span id="template-name"></span>
                        <button type="button" onclick="clearFile('template')">×</button>
                    </div>
                </div>
                <div class="default-badge">⚡ Default template will be used if not uploaded</div>
            </div>

            <!-- Excel Data Upload -->
            <div class="card">
                <div class="card-title">
                    <div class="icon">📊</div>
                    Excel Data File
                </div>
                <div class="upload-zone" id="excelFile-zone">
                    <div class="upload-icon">📈</div>
                    <div class="upload-text">Click to upload Excel data</div>
                    <div class="upload-hint">Excel workbook (.xlsx, .xls, .csv, .xlts, .xlsm) with policy data</div>
                    @Html.TextBox("excelDataFile", null, new { type = "file", accept = ".xlsx,.xls,.xlts,.xlsm, .csv", onchange = "handleUpload(this, 'excelFile')" })
                    <div class="file-badge" id="excelFile-badge" style="display: none;">
                        ✓ <span id="excelFile-name"></span>
                        <button type="button" onclick="clearFile('excelFile')">×</button>
                    </div>
                </div>
                <div class="default-badge">⚡ Default sample data will be used if not uploaded</div>
            </div>
        </div>

        <!-- Policy Selection Section -->
        <div class="card options-card">
            <div class="card-title">
                <div class="icon">🔍</div>
                Policy Selection
            </div>

            <div class="options-grid" style="grid-template-columns: 1fr 2fr;">
                <!-- Selection Mode -->
                <div class="option-box">
                    <label class="option-label">Selection Mode</label>
                    <div class="radio-group">
                        <label class="radio-item">
                            <input type="radio" name="selectionMode" value="specific" checked onchange="togglePolicyInput()" />
                            <div class="item-content">
                                <div class="item-title">🎯 Specific Policies</div>
                                <div class="item-desc">Enter policy numbers</div>
                            </div>
                        </label>
                        <label class="radio-item">
                            <input type="radio" name="selectionMode" value="all" onchange="togglePolicyInput()" />
                            <div class="item-content">
                                <div class="item-title">📋 All Policies</div>
                                <div class="item-desc">Generate for all records</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Policy Numbers Input -->
                <div class="option-box" id="policy-input-section">
                    <label class="option-label">Policy Number(s)</label>
                    <textarea name="policyNumbers"
                          id="policyNumbers"
                          class="select-box"
                          rows="4"
                          placeholder="Enter policy numbers (one per line)&#10;Example:&#10;POL001&#10;POL002&#10;POL003"
                          style="resize: vertical; font-family: monospace; padding: 15px;"></textarea>
                    <div class="item-desc" style="margin-top: 10px; padding: 0 10px; display: flex; align-items: center; gap: 8px;">
                        <span style="color: #667eea;">💡</span>
                        <span>Enter one policy number per line or comma-separated (e.g., POL001, POL002, POL003)</span>
                    </div>
                    <div style="display: flex; align-items: start; gap: 8px; padding: 10px 16px; background: #fff3cd; border-radius: 8px; border-left: 3px solid #ffc107; margin-top: 12px; font-size: 13px; color: #856404;">
                        <span style="font-size: 16px;">⚠️</span>
                        <span><strong>Note:</strong> To create specific policy reports, your data file must contain a Policy Number column.</span>
                    </div>
                    <div id="policy-count" style="margin-top: 8px; padding: 8px 12px; background: #f0f4ff; border-radius: 8px; font-size: 13px; font-weight: 600; color: #667eea; display: none;">
                        <span id="count-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Digital Signature Enable Checkbox -->
        <div class="option-box" style="grid-column: 1 / -1;">
            <label class="radio-item" style="background: white; border: 2px solid #e2e8f0;">
                <input type="checkbox"
                       id="enableDigitalSign"
                       name="enableDigitalSign"
                       value="true"
                       onchange="toggleSignatureSection()"
                       style="width: 20px; height: 20px; margin-right: 10px; cursor: pointer; accent-color: #667eea;" />
                <input type="hidden" name="enableDigitalSign" value="false" />
                <div class="item-content">
                    <div class="item-title" style="font-size: 15px;">✍️ Enable Digital Signature</div>
                    <div class="item-desc">Add digital signatures to generated documents</div>
                </div>
            </label>
        </div>

        <!-- Signature Configuration Section (Hidden by Default) -->
        <div class="signature-section" id="signatureSection" style="grid-column: 1 / -1;">
            <div class="signature-title">✍️ Digital Signature Configuration (Optional)</div>

            <div class="option-box" style="border: none; background: transparent; padding: 0; margin-bottom: 20px;">
                <!-- Signature Image Upload -->
                <div style="margin-bottom: 20px;">
                    <label class="option-label">🖼️ Signature Image File</label>
                    <div style="position: relative; display: inline-block; width: 100%;">
                        <input type="file"
                               id="signatureImage"
                               name="signatureImage"
                               accept=".png,.jpg,.jpeg,.gif,.bmp"
                               onchange="updateFileName(this, 'signatureImageName')"
                               style="width: 100%; padding: 10px; border: 2px solid #e2e8f0; border-radius: 8px; cursor: pointer;" />
                    </div>
                    <div class="helper-text">
                        💡 Upload a custom signature image (PNG, JPG, etc.). If no image is uploaded, the default signature will be placed above the specified keywords in the document.
                    </div>
                </div>

                <!-- Signature Keywords Input -->
                <div style="margin-bottom: 20px;">
                    <label class="option-label">🔍 Signature Placeholder Keywords</label>
                    <input type="text"
                           name="signatureKeywords"
                           id="signatureKeywords"
                           class="text-input"
                           placeholder="e.g., Signature, AuthorizedSign"
                           value="Sign, WITNESS, CompanySignature" />
                    <div class="helper-text">
                        💡 Enter keywords separated by commas to identify where signatures should be placed in your document.
                    </div>
                </div>

                <div class="helper-text" style="background: #fff9e6; padding: 12px; border-left: 4px solid #ffc107; margin-top: 15px; margin-bottom: 0; border-radius: 4px;">
                    📌 <strong>Note:</strong> Digital signatures will be automatically placed <strong>above</strong> the keywords you specify in your document.
                </div>
            </div>
        </div>

        <!-- Options Section -->
        <div class="card options-card">
            <div class="card-title">
                <div class="icon">⚙️</div>
                Generation Options
            </div>

            <div class="options-grid">
                <!-- Output Format -->
                <div class="option-box">
                    <label class="option-label">Output Format</label>
                    <div class="radio-group">
                        <label class="radio-item">
                            <input type="radio" name="outputFormat" value="docx" checked />
                            <div class="item-content">
                                <div class="item-title">📝 DOCX</div>
                                <div class="item-desc">Editable document</div>
                            </div>
                        </label>
                        <label class="radio-item">
                            <input type="radio" name="outputFormat" value="pdf" />
                            <div class="item-content">
                                <div class="item-title">📑 PDF</div>
                                <div class="item-desc">Distribution ready</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Extra Options -->
                <div class="option-box">
                    <label class="option-label">Extra Features</label>
                    <div class="checkbox-list">
                        <label class="checkbox-item">
                            <input type="checkbox" id="multiPartDocument" name="multiPartDocument" />
                            <div class="item-content">
                                <div class="item-title">📑 Cover Page</div>
                                <div class="item-desc">Add cover page</div>
                            </div>
                        </label>
                        <label class="checkbox-item">
                            <input type="checkbox" id="generateSeparateFiles" name="generateSeparateFiles" />
                            <div class="item-content">
                                <div class="item-title">📂 Separate Files</div>
                                <div class="item-desc">Generate individual files per policy</div>
                            </div>
                        </label>
                        <label class="checkbox-item full-width">
                            <input type="checkbox" id="useBookmarkDocuments" name="useBookmarkDocuments" onchange="toggleBookmarkDocumentsSection()" />
                            <div class="item-content">
                                <div class="item-title">📎 Insert Documents Based on Placeholder Text</div>
                                <div class="item-desc">Embed documents at Placeholder text</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Bookmark Documents Section (appears when checkbox is checked) -->
            <div class="bookmark-docs-section" id="bookmark-docs-section">
                <div class="bookmark-docs-title">
                    <span>📎 Add Documents for Placeholder-Based Insertion</span>
                </div>

                <div class="bookmark-info-note">
                    ℹ️ Document file names must exactly match the Placeholder text in your main template. For example, if you have a Placeholder text as "Attachment1", name your document as "Attachment1.docx"
                </div>

                <div class="bookmark-upload-zone" id="bookmark-upload-zone" style="position: relative;">
                    <div class="bookmark-upload-icon">📁</div>
                    <div class="bookmark-upload-text">Click to select documents</div>
                    <div class="bookmark-upload-hint">Supported formats: .docx, .rtf, .doc, .md, .txt, .html (one or more files)</div>
                    <input type="file"
                           id="bookmarkDocumentsInput"
                           name="bookmarkDocuments"
                           multiple
                           accept=".docx,.rtf,.doc,.md,.txt,.html"
                           onchange="handleBookmarkDocumentUpload(this)"
                           class="bookmark-file-input" />
                </div>

                <!-- Uploaded Files List -->
                <div id="uploaded-files-container" style="display: none;">
                    <div class="uploaded-files-list" id="uploaded-files-list">
                    </div>
                    <div class="file-count-badge">
                        <span id="file-count-text">0 files selected</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Generate Button -->
        <div class="action-section">
            <button type="submit" class="generate-btn">
                <span>🚀</span>
                <span>Generate Documents</span>
            </button>
            <div class="error-message">@ViewBag.Message</div>
        </div>
    }

    <!-- Features Section -->
    <div class="info-section">
        <div class="info-title">Platform Capabilities</div>
        <div class="features">
            <div class="feature">
                <div class="feature-icon">🔄</div>
                <h4>Mail Merge</h4>
                <p>Automated field population from JSON data</p>
            </div>
            <div class="feature">
                <div class="feature-icon">📦</div>
                <h4>Batch Generation</h4>
                <p>Create multiple document types at once</p>
            </div>
            <div class="feature">
                <div class="feature-icon">⚡</div>
                <h4>Fast Processing</h4>
                <p>Real-time document generation</p>
            </div>
            <div class="feature">
                <div class="feature-icon">🎨</div>
                <h4>Flexible Templates</h4>
                <p>Use custom or default templates</p>
            </div>
        </div>
    </div>
</div>

<!-- Remove the orphaned validation code and fix the signature section -->
@section Scripts {
    <script>
        // Handle file uploads
        function handleUpload(input, type) {
            const zone = document.getElementById(type + '-zone');
            const badge = document.getElementById(type + '-badge');
            const nameSpan = document.getElementById(type + '-name');

            if (input.files && input.files[0]) {
                nameSpan.textContent = input.files[0].name;
                badge.style.display = 'inline-flex';
                zone.classList.add('has-file');
            }
        }

        // Clear uploaded file
        function clearFile(type) {
            const nameMap = {
                'template':    'templateFile',
                'excelFile':   'excelDataFile'
            };
            const inputName = nameMap[type] || type;
            const input = document.querySelector('input[name="' + inputName + '"]');
            const zone = document.getElementById(type + '-zone');
            const badge = document.getElementById(type + '-badge');

            if (input)  input.value = '';
            if (badge)  badge.style.display = 'none';
            if (zone)   zone.classList.remove('has-file');
        }

        // Toggle bookmark documents section visibility
        function toggleBookmarkDocumentsSection() {
            const checkbox = document.getElementById('useBookmarkDocuments');
            const section = document.getElementById('bookmark-docs-section');

            if (checkbox.checked) {
                section.classList.add('visible');
            } else {
                section.classList.remove('visible');
                clearBookmarkDocuments();
            }
        }

        // Handle bookmark document uploads
        function handleBookmarkDocumentUpload(input) {
            const files = input.files;
            const container = document.getElementById('uploaded-files-container');
            const list = document.getElementById('uploaded-files-list');
            const countBadge = document.getElementById('file-count-text');

            list.innerHTML = '';

            if (files && files.length > 0) {
                container.style.display = 'block';
                countBadge.textContent = `${files.length} ${files.length === 1 ? 'file' : 'files'} selected`;

                Array.from(files).forEach((file, index) => {
                    const fileItem = document.createElement('div');
                    fileItem.className = 'uploaded-file-item';
                    fileItem.id = `file-item-${index}`;

                    const fileExt = file.name.split('.').pop().toLowerCase();
                    const fileIcons = {
                        'docx': '📄',
                        'doc': '📄',
                        'rtf': '📄',
                        'txt': '📝',
                        'md': '📝',
                        'html': '🌐',
                        'htm': '🌐'
                    };
                    const icon = fileIcons[fileExt] || '📎';

                    const fileSize = (file.size / 1024).toFixed(2);
                    const sizeSuffix = fileSize > 1024 ? `${(fileSize / 1024).toFixed(2)} MB` : `${fileSize} KB`;

                    fileItem.innerHTML = `
                        <div class="file-item-info">
                            <div class="file-item-icon">${icon}</div>
                            <div class="file-item-details">
                                <div class="file-item-name">${file.name}</div>
                                <div class="file-item-size">${sizeSuffix}</div>
                            </div>
                        </div>
                        <button type="button" class="file-item-remove" onclick="removeBookmarkFile(${index})">✕</button>
                    `;

                    list.appendChild(fileItem);
                });
            } else {
                container.style.display = 'none';
            }
        }

        // Remove individual bookmark document
        function removeBookmarkFile(index) {
            const input = document.getElementById('bookmarkDocumentsInput');
            const dataTransfer = new DataTransfer();
            const files = input.files;

            Array.from(files).forEach((file, i) => {
                if (i !== index) {
                    dataTransfer.items.add(file);
                }
            });

            input.files = dataTransfer.files;
            handleBookmarkDocumentUpload(input);
        }

        // Clear all bookmark documents
        function clearBookmarkDocuments() {
            const input = document.getElementById('bookmarkDocumentsInput');
            const container = document.getElementById('uploaded-files-container');
            const list = document.getElementById('uploaded-files-list');

            input.value = '';
            container.style.display = 'none';
            list.innerHTML = '';
        }

        // Toggle policy input visibility
        function togglePolicyInput() {
            const selectionMode = document.querySelector('input[name="selectionMode"]:checked').value;
            const policyInputSection = document.getElementById('policy-input-section');
            const policyTextarea = document.getElementById('policyNumbers');

            if (selectionMode === 'all') {
                policyInputSection.style.opacity = '0.5';
                policyInputSection.style.pointerEvents = 'none';
                policyTextarea.value = '';
                policyTextarea.disabled = true;
                document.getElementById('policy-count').style.display = 'none';
            } else {
                policyInputSection.style.opacity = '1';
                policyInputSection.style.pointerEvents = 'auto';
                policyTextarea.disabled = false;
            }
        }

        // Update signature image file name display
        function updateFileName(input, spanId) {
            const span = document.getElementById(spanId);
            if (input.files && input.files.length > 0) {
                span.textContent = input.files[0].name;
            } else {
                if (spanId === 'signatureImageName') {
                    span.textContent = 'Signature.png';
                }
            }
        }

        // Toggle signature section visibility
        function toggleSignatureSection() {
            const checkbox = document.getElementById('enableDigitalSign');
            const signatureSection = document.getElementById('signatureSection');

            if (checkbox.checked) {
                signatureSection.classList.add('visible');
                signatureSection.style.display = 'block';
            } else {
                signatureSection.classList.remove('visible');
                signatureSection.style.display = 'none';
                document.getElementById('signatureImage').value = '';
                document.getElementById('signatureImageName').textContent = 'Signature.png';
                document.getElementById('signatureKeywords').value = 'Sign, WITNESS, AuthorizedSign';
            }
        }

        // Count policy numbers
        document.getElementById('policyNumbers').addEventListener('input', function() {
            const text = this.value.trim();
            if (!text) {
                document.getElementById('policy-count').style.display = 'none';
                return;
            }

            const policies = text.split(/[\n,]+/).map(p => p.trim()).filter(p => p.length > 0);
            const count = policies.length;

            const countDisplay = document.getElementById('policy-count');
            const countText = document.getElementById('count-text');

            if (count > 0) {
                countText.textContent = `${count} ${count === 1 ? 'policy' : 'policies'} will be processed`;
                countDisplay.style.display = 'block';
            } else {
                countDisplay.style.display = 'none';
            }
        });

        // Validate form before submission
        document.querySelector('form').addEventListener('submit', function(e) {
            const selectionMode = document.querySelector('input[name="selectionMode"]:checked').value;
            const policyNumbers = document.getElementById('policyNumbers').value.trim();
            const useBookmarkDocuments = document.getElementById('useBookmarkDocuments').checked;
            const bookmarkInput = document.getElementById('bookmarkDocumentsInput');
            const enableDigitalSign = document.getElementById('enableDigitalSign').checked;
            const signatureKeywords = document.getElementById('signatureKeywords').value.trim();
            const errorDiv = document.querySelector('.error-message');

            // Check if policy numbers are entered in specific mode
            if (selectionMode === 'specific' && !policyNumbers) {
                e.preventDefault();
                errorDiv.textContent = '⚠️ Please enter at least one policy number or select "All Policies" mode';
                errorDiv.style.display = 'block';
                document.getElementById('policy-input-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            // Check if bookmark documents are uploaded when feature is enabled
            if (useBookmarkDocuments && (!bookmarkInput.files || bookmarkInput.files.length === 0)) {
                e.preventDefault();
                errorDiv.textContent = '⚠️ Please upload at least one document for bookmark insertion or disable the feature';
                errorDiv.style.display = 'block';
                document.getElementById('bookmark-docs-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            // Check if signature keywords are provided when digital sign is enabled
            if (enableDigitalSign && !signatureKeywords) {
                e.preventDefault();
                errorDiv.textContent = '⚠️ Please enter signature placeholder keywords or disable digital signature';
                errorDiv.style.display = 'block';
                document.getElementById('signatureSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            errorDiv.style.display = 'none';
        });

        // Convert checkboxes to proper boolean values
        document.querySelector('form').addEventListener('submit', function(e) {
            const multiPartDoc = document.getElementById('multiPartDocument');
            const separateFiles = document.getElementById('generateSeparateFiles');
            const useBookmarkDocs = document.getElementById('useBookmarkDocuments');

            multiPartDoc.value = multiPartDoc.checked ? 'true' : 'false';
            separateFiles.value = separateFiles.checked ? 'true' : 'false';
            useBookmarkDocs.value = useBookmarkDocs.checked ? 'true' : 'false';
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            togglePolicyInput();
        });
    </script>
}
